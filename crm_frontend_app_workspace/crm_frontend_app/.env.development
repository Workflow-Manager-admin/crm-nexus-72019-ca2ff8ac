# PUBLIC_INTERFACE
# .env.development — Dev server config for React/webpack-dev-server
#
# If you see "Invalid Host header" when accessing the frontend
# from Docker, cloud IDE (Codespaces, Gitpod, etc.), or another machine/VM:
# this disables host header checking during development (DANGER: do not use in production).

DANGEROUSLY_DISABLE_HOST_CHECK=true

# Alternatively, to allow only specific hosts (safer), comment out above and set:
# HOST=0.0.0.0
# PORT=3000
# (Now access the app via http://<host-ip>:3000/)

# NOTE: This file takes precedence over .env or process env for the React dev server.

# WARNING: Never set DANGEROUSLY_DISABLE_HOST_CHECK=true in production or public deployments.
